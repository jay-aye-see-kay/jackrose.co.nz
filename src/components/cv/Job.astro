---
import { formatDuration, formatPeriod, type Job } from "../../lib/cv";

interface Props {
  job: Job;
}

const { job } = Astro.props;

// Layout falls out of the markdown's shape:
//   roles with bullet lists -> "roomy" (recent, detailed: Culture Amp)
//   roles with inline text  -> "compact" (long ago, one line each: Fletcher)
//   no roles                -> a plain job
const roomy = job.roles.some((r) => r.bullets.length > 0);
const kind = job.roles.length === 0 ? "plain" : roomy ? "roomy" : "compact";
const multiRole = job.roles.length > 1;

// Single-role jobs that ended 10+ years ago recede (smaller, muted type).
const EARLY_YEARS = 10;
const now = new Date();
const end = job.period?.end;
const early =
  kind === "plain" &&
  end !== undefined &&
  end !== "present" &&
  now.getFullYear() * 12 + now.getMonth() - (end.year * 12 + end.month - 1) >= EARLY_YEARS * 12;
---

<article class:list={["job", `job-${kind}`, { "job-multi": multiRole, "job-early": early }]}>
  <div class="job-when">
    {
      job.period && (
        <>
          <span class="job-dates">{formatPeriod(job.period)}</span>
          <span class="job-duration">{formatDuration(job.period.months)}</span>
        </>
      )
    }
  </div>

  <div class="job-main">
    <h3 class="job-head">
      {
        job.company ? (
          <>
            <span class="job-company">{job.company}</span>
            {job.companyNote && <span class="job-note">{job.companyNote}</span>}
            {!multiRole && <span class="job-title">{job.title}</span>}
          </>
        ) : (
          <span class="job-company">{job.title}</span>
        )
      }
    </h3>

    {job.html && <div class="job-body" set:html={job.html} />}

    {
      job.roles.length > 0 && (
        <ol class="roles" aria-label={`Roles at ${job.company ?? job.title}`}>
          {job.roles.map((role) => (
            <li class="role">
              <div class="role-head">
                <h4 class="role-title">
                  {role.title}
                  {role.team && <span class="role-team">{role.team}</span>}
                </h4>
                {role.period && (
                  <span class="role-dates">
                    {formatPeriod(role.period)}
                  </span>
                )}
              </div>
              {role.summary && <p class="role-summary" set:html={role.summary} />}
              {role.bullets.length > 0 && (
                <ul class="role-bullets">
                  {role.bullets.map((b) => (
                    <li set:html={b} />
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
      )
    }
  </div>
</article>
